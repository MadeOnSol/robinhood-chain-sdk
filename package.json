{
  "name": "robinhood-chain-sdk",
  "version": "0.8.1",
  "description": "Official TypeScript SDK for the Robinhood Chain (chain id 4663) API — EVM-native on-chain trading intelligence: live KOL trades, token discovery & bundles, the DEX trade tape, OHLC candles, deployer reputation, smart-money wallets, and push rule engines (copy-trade, price alerts, KOL coordination, first touches). Zero dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "gen-version": "node scripts/gen-version.mjs",
    "prebuild": "node scripts/gen-version.mjs",
    "build": "tsc",
    "test": "tsc -p examples/tsconfig.json",
    "route-parity": "node scripts/route-parity-check.mjs",
    "preflight": "bash ./scripts/preflight-publish.sh",
    "prepublishOnly": "npm run preflight && npm run build"
  },
  "keywords": [
    "robinhood chain",
    "robinhood-chain",
    "rhc",
    "robinhood chain api",
    "robinhood chain sdk",
    "robinhood-chain-sdk",
    "chain-4663",
    "chain-id-4663",
    "evm",
    "arbitrum-orbit",
    "kol",
    "kol-tracker",
    "deployer-hunter",
    "smart-money",
    "alpha-wallets",
    "memecoin",
    "memecoin-tracker",
    "defi",
    "web3",
    "trading",
    "trade-stream",
    "dex",
    "sdk",
    "api",
    "madeonsol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/madeonsol/robinhood-chain-sdk.git"
  },
  "homepage": "https://madeonsol.com/robinhood",
  "bugs": {
    "url": "https://github.com/madeonsol/robinhood-chain-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "funding": "https://madeonsol.com"
}
